# syntax=docker/dockerfile:1
#
# The signing-party enclave image. Build context: services/mpc-party.
#
#   docker build -f infrastructure/nitro/Dockerfile.enclave \
#     --build-arg ENCLAVE_KMS_REGION=af-south-1 \
#     --build-arg ENCLAVE_KMS_KEYS="1=arn:aws:kms:...,2=...,3=..." \
#     --build-arg ENCLAVE_PARTY_PCR3="1=<hex>,2=<hex>,3=<hex>" \
#     --build-arg CEREMONY_AUTHORIZER_PUBKEY=<hex> \
#     -t forge-mpc-party-enclave services/mpc-party
#   nitro-cli build-enclave --docker-uri forge-mpc-party-enclave:latest --output-file party.eif
#
# Everything set here is part of the image, so it is covered by PCR0 and a
# peer or KMS that checks PCR0 is checking these values too. That is why the
# settings that protect a share are build arguments and not something the
# host passes at run time (see services/mpc-party/enclave_mode.go). One image
# serves every party: the party number comes from the host and is checked
# against the IAM-role pin (PCR3) by the peers and by each party's KMS key.
#
# Reproducibility: anyone rebuilding this from the same commit must get the
# same PCR0, or the measurement proves nothing to them. Hence -trimpath,
# -buildvcs=false, an empty build id, a scratch runtime, no timestamps, and
# a base image pinned by digest: a tag moves, and a moved tag is a new PCR0
# nobody reviewed. infrastructure/nitro/reproduce.sh builds twice and
# compares. Updating the digest is an image upgrade (see "Upgrading the
# enclave image" in docs/engineering/NITRO-ENCLAVE-MPC-PARTY.md).
#
# golang:1.26-bookworm, multi-platform index digest as of 2026-11-10. Written
# out on both lines, not through an ARG, so Dependabot can bump them together.
# The CA bundle the enclave uses for TLS to KMS: Debian's, from the pinned
# image, copied before anything below can modify it.
FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS certs

FROM golang:1.26-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 AS build

RUN --mount=type=secret,id=egress_ca \
    if [ -s /run/secrets/egress_ca ]; then \
      cat /run/secrets/egress_ca >> /etc/ssl/certs/ca-certificates.crt; \
    fi

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -tags nitro -trimpath -buildvcs=false -ldflags='-s -w -buildid=' \
      -o /out/mpc-party .
# Changes nothing but the image, and so PCR0: the spike uses it to show a
# rebuilt image being refused. Written to a file so it is in the root file
# system, not only in the image configuration.
ARG SPIKE_MARKER=""

# The enclave's whole file system, assembled here and copied in one step.
# Every timestamp is set to the epoch: Docker stamps files and directories
# with the time of the build, the EIF's ramdisk keeps those stamps, and two
# builds of the same commit then differ in PCR0 and PCR2 although every byte
# of every file is the same (found by reproduce.sh).
#
# Roots for TLS to KMS come from the certs stage: the egress CA above is
# appended to this stage's bundle only, and must never reach the enclave.
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ca-certificates.crt
RUN cp /out/mpc-party /rootfs/mpc-party \
 && printf '%s' "${SPIKE_MARKER}" > /rootfs/spike-marker \
 && chmod 0755 /rootfs/mpc-party /rootfs/etc /rootfs/etc/ssl /rootfs/etc/ssl/certs \
 && chmod 0644 /rootfs/spike-marker /rootfs/etc/ssl/certs/ca-certificates.crt \
 && find /rootfs -exec touch -h -d @0 {} +

FROM scratch

COPY --from=build /rootfs/ /

# Production: the orchestrator's CA, so it can connect with its PKI
# certificate. Without it only attested parties can connect.
# COPY orchestrator-ca.pem /etc/forge/orchestrator-ca.pem
# ENV ENCLAVE_ORCHESTRATOR_CA_FILE=/etc/forge/orchestrator-ca.pem

ARG ENCLAVE_KMS_REGION
ARG ENCLAVE_KMS_KEYS
ARG ENCLAVE_PARTY_PCR3=""
ARG ENCLAVE_REQUIRE_PARTY_PIN=1
ARG ENCLAVE_EXTRA_IMAGE_PCR0=""
ARG CEREMONY_AUTHORIZER_PUBKEY
ARG CEREMONY_AUTHORIZER_ALG=ed25519
ARG ENCLAVE_SELFTEST=0
# Break-glass: 1=<hex>,2=<hex>,3=<hex> from `forge-enclave-admin recovery-keygen`,
# one per party, each held offline by different recovery officers.
ARG ENCLAVE_RECOVERY_PUBKEYS=""
ARG ENCLAVE_REQUIRE_RECOVERY=0

ENV ENCLAVE_MODE=1 \
    ENCLAVE_VSOCK_PORT=5000 \
    ENCLAVE_CONTROL_PORT=9000 \
    ENCLAVE_KMS_REGION=${ENCLAVE_KMS_REGION} \
    ENCLAVE_KMS_KEYS=${ENCLAVE_KMS_KEYS} \
    ENCLAVE_PARTY_PCR3=${ENCLAVE_PARTY_PCR3} \
    ENCLAVE_REQUIRE_PARTY_PIN=${ENCLAVE_REQUIRE_PARTY_PIN} \
    ENCLAVE_EXTRA_IMAGE_PCR0=${ENCLAVE_EXTRA_IMAGE_PCR0} \
    CEREMONY_AUTHORIZER_PUBKEY=${CEREMONY_AUTHORIZER_PUBKEY} \
    CEREMONY_AUTHORIZER_ALG=${CEREMONY_AUTHORIZER_ALG} \
    ENCLAVE_SELFTEST=${ENCLAVE_SELFTEST} \
    ENCLAVE_RECOVERY_PUBKEYS=${ENCLAVE_RECOVERY_PUBKEYS} \
    ENCLAVE_REQUIRE_RECOVERY=${ENCLAVE_REQUIRE_RECOVERY}

ENTRYPOINT ["/mpc-party"]
