# Copy to .env and fill in. Docker Compose reads .env automatically.

# Sepolia JSON-RPC URL. Without it the gateway signs + audits but does not broadcast.
ETHEREUM_RPC_SEPOLIA=https://sepolia.infura.io/v3/YOUR_KEY

# Optional: pin the shared signer address across restarts. TESTNET ONLY.
# Generate one with: openssl rand -hex 32
MPC_SIGNER_PRIVATE_KEY=
